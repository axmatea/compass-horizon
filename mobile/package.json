{
  "name": "compass-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "bundle": "expo export --platform all"
  },
  "dependencies": {
    "expo": "58.0.26",
    "expo-crypto": "58.0.8",
    "expo-file-system": "58.0.14",
    "expo-haptics": "58.0.8",
    "expo-image-picker": "58.0.10",
    "expo-notifications": "58.1.9",
    "expo-secure-store": "58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-webview": "14.0.1"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.8"
    }
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "5.9.3"
  }
}
