{
  "name": "compass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.mjs",
    "test": "node --experimental-strip-types --test --test-concurrency=1 'test/*.test.mjs' src/workspace/*.test.mjs src/auth/*.test.mjs src/core.test.mjs",
    "test:auth": "node --test --test-concurrency=1 test/acquisition-auth.test.mjs",
    "test:workspaces": "node --experimental-strip-types --test --test-concurrency=1 test/workspace*.test.mjs src/workspace/*.test.mjs",
    "db:test": "node scripts/acquisition-test-db.mjs",
    "start:local": "node --env-file-if-exists=.env server.mjs",
    "invite": "node scripts/acquisition-invite.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "5.8.3",
    "vite": "7.3.7"
  }
}
