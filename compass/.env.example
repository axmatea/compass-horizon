# Optional homepage and demo settings. No key is required.
# The demo serves a prepared example when these are unset or the model call fails.
PORT=8770
# Railway injects RAILWAY_GIT_COMMIT_SHA. A manual release may set COMPASS_REVISION.
# COMPASS_REVISION=
# Read on each request. https URL only. Unset hides the video section.
# An https URL renders the player and the Watch the video link.
# DEMO_VIDEO_URL=
# https URL only. The server posts {"email","timestamp"} here.
# Unset keeps the mailto:info@aimedia.global fallback. No email is stored.
# WAITLIST_WEBHOOK_URL=
# DEMO_RATE_LIMIT=30
# DEMO_RATE_WINDOW_MS=600000

# Optional model. Server-side only. Never prefix with VITE_.
# auto (default) tries General Compute, then Nebius. generalcompute | nebius forces one.
# LLM_PROVIDER=auto
# GENERAL_COMPUTE_API_KEY=
# GENERALCOMPUTE_API_KEY=
# GENERAL_COMPUTE_MODEL=minimax-m2.7
# GENERALCOMPUTE_MODEL=minimax-m2.7
# A chat 404, or a model-not-found error code, loads GET /v1/models once,
# caches the active ids for 10 minutes, and retries one preferred id.
# Preference: gpt-oss-120b, minimax-m2.7, deepseek-v3.2, deepseek-v3.1, then any other active id.
# GENERAL_COMPUTE_BASE_URL=https://api.generalcompute.com/v1/
# GENERALCOMPUTE_BASE_URL=https://api.generalcompute.com/v1/
# GENERALCOMPUTE_TIMEOUT_MS=8000
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
# NEBIUS_MODEL=zai-org/GLM-5.3
# When NEBIUS_MODEL is unset, the call uses NEBIUS_FALLBACK_MODEL or the
# documented fast flavor zai-org/GLM-5.3-fast. A model-not-found on that id
# retries the base model once, inside the same timeout.
# NEBIUS_FALLBACK_MODEL=zai-org/GLM-5.3-fast
# off (anything but on) sends reasoning_effort=low and, on clarify, caps
# max_completion_tokens at 512 so reasoning cannot run past the timeout.
# GLM-5.3 cannot disable reasoning. The hard cap stays 12s.
# NEBIUS_THINKING=off
# NEBIUS_TIMEOUT_MS=8000
