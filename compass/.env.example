# Optional homepage and demo settings. No key is required.
# The demo serves a prepared example when these are unset or the model call fails.
PORT=8770
# Railway injects RAILWAY_GIT_COMMIT_SHA. A manual release may set COMPASS_REVISION.
# COMPASS_REVISION=
# Read on each request. https URL only. Unset hides the video section.
# An https URL renders the player and the Watch the video link.
# DEMO_VIDEO_URL=
# https URL only. The server posts {"email","timestamp"} here.
# Unset keeps the mailto:info@aimedia.global fallback. No email is stored.
# WAITLIST_WEBHOOK_URL=
# DEMO_RATE_LIMIT=30
# DEMO_RATE_WINDOW_MS=600000

# Prepared examples are the public default, even when provider keys exist.
# Unset or invalid values also use examples. Only the exact value live enables
# optional model calls, after the founder confirms a provider.
# COMPASS_DEMO_MODE=examples

# Optional model. Server-side only. Never prefix with VITE_.
# These settings are used only with COMPASS_DEMO_MODE=live in the Node server.
# Vite dev/preview always stay on prepared examples.
# auto (default) tries Anthropic when its key is set, then General Compute, then Nebius.
# generalcompute | nebius | anthropic forces one.
# LLM_PROVIDER=auto
# GENERAL_COMPUTE_API_KEY=
# GENERALCOMPUTE_API_KEY=
# GENERAL_COMPUTE_MODEL=minimax-m2.7
# GENERALCOMPUTE_MODEL=minimax-m2.7
# A chat 404, or a model-not-found error code, loads GET /v1/models once,
# caches the active ids for 10 minutes, and retries one preferred id.
# Preference: gpt-oss-120b, minimax-m2.7, deepseek-v3.2, deepseek-v3.1, then any other active id.
# GENERAL_COMPUTE_BASE_URL=https://api.generalcompute.com/v1/
# GENERALCOMPUTE_BASE_URL=https://api.generalcompute.com/v1/
# GENERALCOMPUTE_TIMEOUT_MS=8000
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
# NEBIUS_MODEL=zai-org/GLM-5.3
# When NEBIUS_MODEL is unset, the call uses NEBIUS_FALLBACK_MODEL or the
# documented fast flavor zai-org/GLM-5.3-fast. A model-not-found on that id
# retries the base model once, inside the same timeout.
# NEBIUS_FALLBACK_MODEL=zai-org/GLM-5.3-fast
# off (anything but on) sends reasoning_effort=low and, on clarify, caps
# max_completion_tokens at 512 so reasoning cannot run past the timeout.
# GLM-5.3 cannot disable reasoning. The hard cap stays 12s.
# NEBIUS_THINKING=off
# NEBIUS_TIMEOUT_MS=8000
# Optional. When set, Anthropic is tried first, then General Compute, then Nebius.
# The same 8s cap applies. A failure skips to the next provider, then to prepared copy.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
# ANTHROPIC_TIMEOUT_MS=8000

# Complete account preview. Never enable this on the primary production domain.
# COMPASS_ACCOUNT_MODE=staging
# COMPASS_ACCOUNT_ORIGIN=https://your-existing-preview.up.railway.app
# COMPASS_ACCOUNT_DATABASE=/absolute/private/compass.sqlite
# BETTER_AUTH_SECRET=
# Synthetic .test QA only: generates a server-memory secret, restart ends sessions.
# COMPASS_ACCOUNT_EPHEMERAL_SECRET=1
# Durable readiness requires a real existing mounted volume and fixed secret.
# COMPASS_STORAGE_MODE=persistent-volume
# COMPASS_BACKUP_DIRECTORY=/absolute/existing/private-backups
# COMPASS_ADMIN_USER_IDS=comma-separated-verified-user-ids
# ANTHROPIC_STREAMING=on
# Test billing: exact cost policy, offers and Stripe test credentials required.
# See ../docs/BILLING_COMPLETE.md; never copy invented sample prices to production.
# COMPASS_BILLING_MODE=test
# COMPASS_BILLING_ORIGIN=https://your-existing-preview.up.railway.app
# COMPASS_CREDIT_POLICY_JSON=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Tool OAuth is separate from account login and Codex engineering connectors.
# See ../docs/INTEGRATIONS_COMPLETE.md for exact scopes/callbacks/provider gates.
# COMPASS_INTEGRATIONS_MODE=staging
# COMPASS_INTEGRATION_ENCRYPTION_KEY=
# COMPASS_GITHUB_CLIENT_ID=
# COMPASS_GITHUB_CLIENT_SECRET=
# COMPASS_GOOGLE_CLIENT_ID=
# COMPASS_GOOGLE_CLIENT_SECRET=
# COMPASS_NOTION_CLIENT_ID=
# COMPASS_NOTION_CLIENT_SECRET=
# COMPASS_NOTION_READ_ONLY=true
# COMPASS_SLACK_CLIENT_ID=
# COMPASS_SLACK_CLIENT_SECRET=
# COMPASS_SLACK_PKCE_ENABLED=true
# COMPASS_GITHUB_PUBLIC_EXPORT=true

# Account sign-in credentials are separate from tool OAuth credentials above.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# COMPASS_ACCOUNT_EMAIL_WEBHOOK_URL=
# COMPASS_ACCOUNT_EMAIL_WEBHOOK_TOKEN=
