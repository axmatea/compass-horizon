# Copy to .env (gitignored). Server-side only. Never prefix with VITE_.
# Inference (hackathon sponsor): General Compute first, Nebius as automatic failover.
# Names follow the hackathon quickstart (GENERAL_COMPUTE_API_KEY); GENERALCOMPUTE_* is accepted too.
GENERAL_COMPUTE_API_KEY=
# minimax-m2.7 (tool calling + json_object verified in docs). The quickstart's gemma-4-31B-it can be set here once verified for tool calling.
GENERAL_COMPUTE_MODEL=minimax-m2.7
# auto (default) | generalcompute | nebius
LLM_PROVIDER=auto
# Voice (hackathon sponsor): Gradium streaming STT + TTS through the server-side bridge.
GRADIUM_API_KEY=
# Flagship voices: zoey NbpkqMVS3CJeq2j8 (default), sunnie YVzbrdWnnu9FgRn5, harper 4SZHfMpw-p46Ywgs
GRADIUM_VOICE_ID=
GRADIUM_VOICE_NAME=zoey
GRADIUM_STT_LANGUAGE=en
# Turn-taking (Pipecat Gradium STT reference defaults): horizon 3 s, inactivity threshold 0.5, 8 cooldown frames after flush
GRADIUM_EOT_HORIZON_S=3
GRADIUM_EOT_THRESHOLD=0.5
GRADIUM_POST_FLUSH_COOLDOWN_FRAMES=8
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_MODEL=zai-org/GLM-5.3
# off (default) disables GLM reasoning tokens for low latency; set "on" to enable
NEBIUS_THINKING=off
NEBIUS_TIMEOUT_MS=20000
BOSON_API_KEY=
# auto (default): Gradium when GRADIUM_API_KEY is set, else Boson when BOSON_API_KEY is set, else browser speech. gradium | boson | browser = force
VOICE_PROVIDER=auto
# Higgs voice for COMPASS (audition 2026-09-18 chose nora); semantic_vad (default) | server_vad
BOSON_VOICE=nora
BOSON_TURN_DETECTION=semantic_vad
# Simulated duration of the mock tool, to exercise interruption
# Tools: osm = real OpenStreetMap restaurant search (default, keyless) | mock = sample data
COMPASS_TOOLS=osm
MOCK_TOOL_DELAY_MS=1500
# Acquisition: server-side only. Missing settings explicitly block private SaaS.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8770
ACQUISITION_SPONSOR_CALLS_ENABLED=false
ACQUISITION_VOICE_ENABLED=false
NIMBLE_API_KEY=
LIQUID_BASE_URL=
LIQUID_MODEL=
LIQUID_API_KEY=
TINYBIRD_HOST=
TINYBIRD_APPEND_TOKEN=
TINYBIRD_READ_TOKEN=
TINYBIRD_HASH_KEY=
TINYBIRD_DATASOURCE=acquisition_lead_versions

# REMaster: Vincent's runtime, not implemented by this frontend.
# No upstream request before the live gate, invitation and provider budget approval.
REMASTER_LIVE_ENABLED=false
REMASTER_RUNTIME_URL=
REMASTER_RUNTIME_TOKEN=
